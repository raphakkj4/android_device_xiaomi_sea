        <Preference
            android:key="gpu"
            android:icon="@drawable/ic_gpu"
            android:summary="@string/gpu_summary"
            android:title="@string/gpu_title" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/category_diagnostics">

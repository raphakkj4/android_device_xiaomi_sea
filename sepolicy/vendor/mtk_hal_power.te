binder_call(mtk_hal_power, hal_power_default)

add_service(mtk_hal_power, mtk_hal_power_service)

binder_call(hal_audio_default, mtk_hal_power)
allow hal_audio_default mtk_hal_power_service:service_manager find;

binder_call(vpud_native, mtk_hal_power)
allow vpud_native mtk_hal_power_service:service_manager find;
